rules_version = '2';

// Regras do Firestore do projeto testebd-80d9e.
//
// ATENÇÃO: as regras valem para o PROJETO INTEIRO, não só para o Listas. Publicar este
// arquivo substitui as regras atuais de todas as coleções.
//
// Banco totalmente fechado para o navegador. Quem acessa são só os servidores, pelo
// firebase-admin (conta de serviço), que IGNORA estas regras:
//   - listas-api            -> listas_usuarios/**
//   - questoes-rapidas-api  -> questoes, meta
//
// Estas regras só valem para quem usa o SDK web/mobile com a apiKey (que é pública).
// Se algum app novo precisar ler direto do navegador, libere só a coleção dele aqui.
//
// Publicar: npm run regras   (veja o README, seção "Fechar o banco")

service cloud.firestore {
  match /databases/{database}/documents {
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
