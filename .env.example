PORT=3000

# Segredo que assina os tokens (mínimo 32 caracteres). Gere um com: npm run segredo
# Trocar este valor desconecta todos os usuários.
JWT_SECRET=
# Validade do token (formato do pacote "ms": 7d, 12h, 30d...).
JWT_EXPIRES_IN=30d

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,https://jooemanoel.github.io

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada). Copie os campos do JSON baixado.
# A chave privada vai entre aspas, com as quebras de linha como \n.
FIREBASE_PROJECT_ID=testebd-80d9e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
